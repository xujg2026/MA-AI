# East Money API Key for mx-skills
EM_API_KEY=

# Optional server port
PORT=3001

#LLM (server/src/config/llm.ts)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=


# QCC API (server/src/config/qcc.ts)
QCC_API_KEY=
QCC_SECRET=

# News Module Configuration
# RSSHub URL (default: http://localhost:1200)
RSSHUB_URL=http://localhost:1200

# AI Model for news analysis (uses EM_API_KEY if not set)
AI_API_KEY=
AI_MODEL=gpt-4o-mini
