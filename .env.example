# Frontend API base URL
# Use /api when your frontend and backend are served behind the same origin.
VITE_API_BASE_URL=/api

# News Module Configuration
# Set to 'true' to use real news data, 'false' to use mock data
VITE_USE_REAL_NEWS=false

# News polling interval in milliseconds (default: 30000 = 30s)
VITE_NEWS_POLL_INTERVAL=30000

# RSSHub URL (default: http://localhost:1200)
VITE_RSSHUB_URL=http://localhost:1200
