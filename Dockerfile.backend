FROM node:20-alpine

WORKDIR /app

# Use Aliyun mirrors for faster download in China
RUN sed -i 's/dl-cdn.alpinelinux.org/mirrors.aliyun.com/g' /etc/apk/repositories

# Install Python and pip for akshare
RUN apk add --no-cache python3 py3-pip && \
    python3 -m venv /opt/venv && \
    /opt/venv/bin/pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com akshare

# Set PATH to include virtual environment
ENV PATH="/opt/venv/bin:$PATH"

# Copy package files
COPY server/package*.json ./

# Install dependencies
RUN npm ci && npm cache clean --force

# Copy server source
COPY server/ .

# Build TypeScript
RUN npm run build

EXPOSE 3001

CMD ["node", "dist/index.js"]